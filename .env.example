BOT_TOKEN=123456:replace_me
PUBLIC_BASE_URL=https://example.com
DATABASE_PATH=data/app.db
# Telegram numeric user IDs, separated by commas. Empty = admin access disabled.
ADMIN_IDS=
# Private directory; never serve it as static files or an nginx alias.
MEDIA_PATH=data/material_images
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_replace_me
SUBSCRIPTION_PRICE=120.00
SUBSCRIPTION_DAYS=30
PROXY_URL=
# true only when uvicorn is reachable exclusively through nginx.
TRUST_PROXY_HEADERS=true
# Keep false after YooKassa acceptance. Legacy keys below are then ignored.
ENABLE_LEGACY_YOOMONEY=false
# Required only when ENABLE_LEGACY_YOOMONEY=true.
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
