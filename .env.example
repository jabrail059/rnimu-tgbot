BOT_TOKEN=123456:replace_me
PUBLIC_BASE_URL=https://example.com
DATABASE_PATH=data/app.db
# Telegram numeric user IDs, separated by commas. Empty = admin access disabled.
ADMIN_IDS=
# Legacy ADMIN_USER_IDS is supported only when ADMIN_IDS is absent.
# Private directory; never serve it as static files or an nginx alias.
MEDIA_PATH=data/material_images
# Maximum source photo size. Images are normalized and limited to 50 megapixels.
IMAGE_MAX_SIZE_MB=50
# PDF uploads are streamed to disk. Match a higher limit in deploy/nginx.conf.
PDF_MAX_SIZE_MB=512
# When upgrading, keep the existing media directory (legacy MEDIA_DIR).
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_replace_me
SUBSCRIPTION_PRICE=120.00
SUBSCRIPTION_DAYS=30
# Daily reminders during the final 72 hours; hour in Europe/Moscow (0–23).
SUBSCRIPTION_REMINDER_HOUR=10
# Distinct photos, PDF pages and material texts per rolling window, per subscriber.
# Re-reading the same page does not consume another distinct-page allowance.
READ_PAGES_PER_MINUTE=40
READ_PAGES_PER_HOUR=180
READ_PAGES_PER_DAY=600
PROXY_URL=
# true only when uvicorn is reachable exclusively through nginx.
TRUST_PROXY_HEADERS=true
# Keep false after YooKassa acceptance. Legacy keys below are then ignored.
ENABLE_LEGACY_YOOMONEY=false
# Required only when ENABLE_LEGACY_YOOMONEY=true.
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
